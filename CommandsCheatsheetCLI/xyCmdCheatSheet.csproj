<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<!-- dotnet tool packaging -->
	<PropertyGroup>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>xycmd</ToolCommandName>
		<PackageId>xyCmdCheatSheet</PackageId>
		<PackageVersion>1.0.2</PackageVersion>
		<Authors>ThrashingLaggard</Authors>
		<Description>
			CLI-Tool to show (custom) commands in the cli.
			usage:
			cmd								-   all commands
			cmd [git/dotnet/...]		-   show commands of a specific category
			cmd --list						-   show only the categories
		</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>

	</PropertyGroup>
	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Infos\" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="xyToolz" Version="1.2.1" />

		<!-- Heavy transitive Deps from xyToolz-->
		<PackageReference Include="System.IdentityModel.Tokens.Jwt"            Version="8.14.0"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="System.Drawing.Common"                      Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="System.Security.Cryptography.Pkcs"          Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="System.Diagnostics.DiagnosticSource"        Version="9.0.10" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="System.Formats.Asn1"                        Version="9.0.10" ExcludeAssets="all" PrivateAssets="all" />


		<!-- Options hatte falsche Version -->
		<PackageReference Include="Microsoft.Bcl.Cryptography"                 Version="9.0.10" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Options"               Version="9.0.10" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.IdentityModel.Logging"            Version="8.14.0" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.IdentityModel.Abstractions"       Version="8.14.0" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.IdentityModel.Tokens"             Version="8.14.0"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.IdentityModel.JsonWebTokens"      Version="8.14.0"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Configuration"              Version="9.0.10" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json"         Version="9.0.10" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Localization.Abstractions"  Version="10.0.5" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection"             Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Physical"          Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions"      Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.FileSystemGlobbing"              Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Extensions.Logging"                         Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Win32.SystemEvents"                         Version="9.0.10"  ExcludeAssets="all" PrivateAssets="all" />

		<PackageReference Include="Newtonsoft.Json"                            Version="13.0.4"  ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="PDFsharp"                                   Version="6.2.2"   ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="PdfSharpCore"                               Version="1.3.67"  ExcludeAssets="all" PrivateAssets="all" />
